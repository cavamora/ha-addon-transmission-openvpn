{
  "name": "Transmission OpenVPN",
  "version": "1.0.0",
  "slug": "transmission_openvpn",
  "description": "Transmission BitTorrent client routed through OpenVPN, using haugene/transmission-openvpn.",
  "url": "https://github.com/cavamora/ha-addon-transmission-openvpn/tree/main/transmission-openvpn",
  "arch": ["amd64", "aarch64"],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "privileged": ["NET_ADMIN"],
  "devices": ["/dev/net/tun"],
  "ports": {
    "9091/tcp": 9091,
    "8118/tcp": null
  },
  "ports_description": {
    "9091/tcp": "Transmission Web UI / RPC",
    "8118/tcp": "Optional Privoxy web proxy"
  },
  "map": ["downloads:rw", "share:rw"],
  "options": {
    "OPENVPN_PROVIDER": "PIA",
    "OPENVPN_CONFIG": "france",
    "OPENVPN_USERNAME": "",
    "OPENVPN_PASSWORD": "",
    "LOCAL_NETWORK": "192.168.0.0/16",
    "TRANSMISSION_RPC_USERNAME": "",
    "TRANSMISSION_RPC_PASSWORD": "",
    "TRANSMISSION_WEB_UI": "transmission-web-control",
    "TRANSMISSION_DOWNLOAD_DIR": "/downloads/completed",
    "TRANSMISSION_INCOMPLETE_DIR": "/downloads/incomplete",
    "TRANSMISSION_WATCH_DIR": "/downloads/watch",
    "WEBPROXY_ENABLED": false,
    "WEBPROXY_PORT": 8118,
    "TZ": "America/Sao_Paulo"
  },
  "schema": {
    "OPENVPN_PROVIDER": "str",
    "OPENVPN_CONFIG": "str?",
    "OPENVPN_USERNAME": "str",
    "OPENVPN_PASSWORD": "password",
    "LOCAL_NETWORK": "str",
    "TRANSMISSION_RPC_USERNAME": "str?",
    "TRANSMISSION_RPC_PASSWORD": "password?",
    "TRANSMISSION_WEB_UI": "list(default|combustion|kettu|flood-for-transmission|shift|transmissionic|transmission-web-control)",
    "TRANSMISSION_DOWNLOAD_DIR": "str",
    "TRANSMISSION_INCOMPLETE_DIR": "str",
    "TRANSMISSION_WATCH_DIR": "str",
    "WEBPROXY_ENABLED": "bool",
    "WEBPROXY_PORT": "port",
    "TZ": "str"
  }
}
